# Copy this file to .env and fill in values. Never commit .env.

# AI provider: "demo" (no key needed), "gemini" or "openai"
AI_PROVIDER=demo

# Google Gemini (only used when AI_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (only used when AI_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of allowed browser origins (frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Request limits
MAX_MESSAGE_CHARS=1000
MAX_HISTORY_MESSAGES=10
PROVIDER_TIMEOUT_SECONDS=20

# Simple in-memory rate limit (requests per IP per window)
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Expose FastAPI docs at /docs (true/false)
ENABLE_DOCS=true
